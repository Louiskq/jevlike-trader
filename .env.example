# Copy to .env (never commit .env). Testnet only; any other NETWORK is rejected.
# Load it with: uv run --env-file .env python -m jevhl.run --live --db live.db
NETWORK=testnet
COIN=BTC

# Needed only for --live (real testnet orders). A dry run needs neither.
# HL_API_KEY: the API (agent) wallet's PRIVATE key. It can only sign orders for your account;
#   it cannot withdraw. Secret: never commit, paste or log it.
HL_API_KEY=
# HL_ACCOUNT_ADDRESS: your MAIN testnet account's public address (0x + 40 hex), NOT the API
#   wallet's address. Fills, positions and open orders are read for this address; asking about
#   the API wallet's address returns nothing. Not a secret.
HL_ACCOUNT_ADDRESS=

GATE=0.60
HORIZON_S=60
DECIDER_DEADLINE_S=2.0
# For the first live hour keep the size small: the minimum order is $10, so a cap of 15 means
# about one minimum-size position at a time.
MAX_POSITION_USD=500
MAX_DAILY_LOSS_USD=100
